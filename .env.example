# Copy this file to .env and fill in ONE key. If any key is set, it is used instead of the Claude CLI.

# Anthropic (Claude), default model claude-opus-5-5
ANTHROPIC_API_KEY=
# OpenAI, default model gpt-5
OPENAI_API_KEY=
# Google Gemini (GOOGLE_API_KEY also works), default model gemini-2.5-flash
GEMINI_API_KEY=
# OpenRouter, default model openai/gpt-5
OPENROUTER_API_KEY=
# Any OpenAI-compatible server (DeepSeek, Groq, Mistral, Together, Ollama http://localhost:11434/v1). Needs LLM_MODEL.
LLM_BASE_URL=
# Key for LLM_BASE_URL (leave empty for local servers)
LLM_API_KEY=
# Force one backend: anthropic | openai | gemini | openrouter | openai_compatible | claude_cli
LLM_PROVIDER=
# Override the default model (required with LLM_BASE_URL)
LLM_MODEL=
# Seconds per call, overrides config.yaml (raise it for slow local models)
LLM_TIMEOUT=
# Path to claude.exe, only for the Claude CLI fallback
CLAUDE_BIN=
